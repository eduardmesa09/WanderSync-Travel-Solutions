# Copiar a .env y completar. El archivo .env nunca se sube al repositorio.
# Las direcciones internas entre contenedores (Prefect, Dask) las define
# docker-compose.yml; no se ponen aquí porque Prefect lee este archivo al
# ejecutarse en local y apuntaría a hosts que solo existen dentro de Docker.

# Supabase Cloud: usar la cadena del "Transaction pooler" (puerto 6543).
# - La conexión directa suele ser solo IPv6 y Docker no la alcanza.
# - El "Session pooler" (puerto 5432) admite 15 clientes en total y el stack los agota.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Sesiones y rate limiting
REDIS_URL=redis://redis:6379/0

# Frontend
VITE_GRAPHQL_URL=http://localhost:8000/graphql
